<li class="list-entry">
    {{!-- Name --}}
    <a class="array-button" data-action="entryEdit" data-list-key="{{listKey}}" data-list-path="{{listPath}}"
        data-entry-key="{{entry.key}}" data-tooltip="{{entry.desc}}">
        {{localize entry.name}}
    </a>
    
    {{!-- Granted By Effect --}}
    {{#if grantedBy}}
    {{#with grantedBy}}
    <img class="mini-icon circle info ml-1" src="{{ img }}" data-tooltip="{{ tooltip }}">
    {{/with}}

    {{!-- Buttons --}}
    {{else if isEditMode}}
    <span class="edit-buttons">
        {{!-- Edit --}}
        {{#unless noEdit}}
        <a class="array-button" data-action="entryEdit" data-list-key="{{listKey}}" data-list-path="{{listPath}}"
            data-entry-key="{{entry.key}}" data-tooltip="WW.ListEntry.{{loc}}.Edit">
            <i class="fa-solid fa-edit"></i>
        </a>
        {{/unless}}

        {{!-- Remove --}}
        <a class="array-button" data-action="entryRemove" data-list-key="{{listKey}}" data-list-path="{{listPath}}"
            data-entry-key="{{entry.key}}" data-tooltip="WW.ListEntry.{{loc}}.Remove">
            <i class="fa-solid fa-trash"></i>
        </a>
    </span>
    {{/if}}
</li>