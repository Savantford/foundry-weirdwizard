<li class="list-entry char-option">
  {{!-- Label --}}
  <a {{#if opt.invalid}}class="invalid"{{/if}} data-action="journalView" data-page-uuid="{{ opt.uuid }}"
    data-tooltip="{{#if opt.invalid}}{{localize "WW.CharOption.Reference.InvalidTip"}}{{else}}{{ opt.text.content }}{{/if}}">
    {{ opt.name }}
  </a>
  
  {{#if isEditMode}}
  <span class="edit-buttons">
    {{!-- Sync Button --}}
    <a class="item-button" data-action="journalResync" data-page-uuid="{{ opt.uuid }}" data-tooltip="{{localize "WW.CharOption.Resync"}}">
      <i class="fa-solid fa-sync"></i>
    </a>

    {{!-- Remove Button --}}
    <a class="item-button" data-action="journalRemove" data-page-uuid="{{ opt.uuid }}" data-tooltip="{{localize (lookup @root.cOptionRemoveTips opt.type)}}">
      <i class="fa-solid fa-trash"></i>
    </a>
  </span>
  {{/if}}
</li>