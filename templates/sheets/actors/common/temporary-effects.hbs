<section class="tab scrollable{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{!-- Afflictions List --}}
  <ol class="list-entries afflictions stat mb-2">
    <label>{{localize "WW.Affliction.Label"}}:</label>

    {{#each afflictions as |affliction id|}}
      <li class="list-entry affliction" data-tooltip="{{affliction.description}}">
        <img class="icon" src="{{affliction.img}}">
        {{localize affliction.name}}
      </li>
    {{/each}}

    <a data-action="afflictionsMenu"><i class="fa-solid {{#if afflictions.length}}fa-edit{{else}}fa-circle-plus{{/if}}"></i></a>

  </ol>
  
  {{!-- Temporary Effects --}}
  {{#each effectCategories as |cat|}}
  <h3 class="cat-heading">
    {{localize cat.name}}

    {{!-- Category Control Buttons --}}
    {{#if (eq cat.id 'afflictions')}}
      <a class="cat-control" data-action="afflictionsMenu"><i class="fa-solid {{#if cat.effects.length}}fa-edit{{else}}fa-circle-plus{{/if}}"></i></a>

    {{else if cat.showCreate}}
      <a class="cat-control effect-control" data-action="effectCreate" data-type="{{ cat.id }}" data-tooltip="WW.Effect.Create"><i class="fa-solid fa-circle-plus"></i></a>
    {{/if}}
  </h3>

  {{!-- Effect Cards --}}
  <ol class="effects cards {{cat.id}}">
    {{#each cat.effects}}
      {{> "systems/weirdwizard/templates/sheets/actors/common/parts/effect-card.hbs" cat=cat }}
    {{/each}}
  </ol>
  {{/each}}
</section>