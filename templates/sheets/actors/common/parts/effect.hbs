<li class="effect-card" data-effect-id="{{this._id}}">
  {{#with this}}
  {{!-- Image --}}
  <img class="image" src="{{ img }}">

  {{!-- Main block --}}
  <div class="main">
    <div class="header">
      {{!-- Title --}}
      <label class="item-button" data-action="itemLabelClick" data-item-id="{{ _id }}" data-tooltip="{{ tooltip }}">{{ name }}</label>

      {{!-- Controls --}}
      <div class="effect-controls flexrow">
        {{#if showRemoveButton}}

        <a class="effect-control" data-action="effectToggle" data-effect-id="{{ _id }}" data-tooltip="WW.Effect.Toggle">
          <i class="fa-solid {{#if disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i>
        </a>

        <a class="effect-control" data-action="effectEdit" data-effect-id="{{ _id }}" data-tooltip="WW.Effect.Edit">
          <i class="fa-solid fa-edit"></i>
        </a>

        <a class="effect-control" data-action="effectRemove" data-effect-id="{{ _id }}" data-tooltip="WW.Effect.Remove">
          <i class="fa-solid fa-trash"></i>
        </a>
        {{else}}
        <a data-tooltip="{{#if isBenefit}}WW.Effect.HandledByCharOption{{else}}WW.Effect.HandledByItem{{/if}}">
          <i class="fa-solid fa-circle-question"></i>
        </a>
        {{/if}}
      </div>
    </div>

    <div class="tags">
      {{!-- Duration --}}
      {{#if (ne duration.expiry "luckEnds")}}
      <div class="frame duration">
        <img src="systems/weirdwizard/assets/icons/hourglass.svg" height="13"> {{ duration.label }}
      </div>
      {{else}}
      {{!-- Luck Ends --}}
      <a class="frame duration luck-ends" data-action="effectLuckEnds" data-effect-id="{{ _id }}">
        <img src="systems/weirdwizard/assets/icons/clover.svg" height="13"> {{localize "WW.Effect.Duration.Expiry.LuckEnds"}}
      </a>
      {{/if}}

      {{!-- Source --}}
      {{!--<div class="frame source effect-source">
        {{{ sourceCard }}}
      </div>--}}
    </div>
  </div>
  {{/with}}
</li>