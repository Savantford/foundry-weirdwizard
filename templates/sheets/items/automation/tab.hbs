<section class="tab{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
  {{!-- Automation Steps --}}
  <button data-action="stepCreate"></button>

  <ol class="automation-steps">
    {{#each system.autoSteps as |step idx|}}
      {{> "systems/weirdwizard/templates/sheets/items/automation/step.hbs" idx=idx fields=@root.stepFields}}
    {{/each}}
  </ol>
  
  <div class="flex-1"></div>
  <hr class="bug">
</section>