<div class="roll-settings">
  {{!-- Attribute Roll --}}
  <div class="flex-row stat-inline nowrap flex-wrap gap-5">
    {{localize "WW.Roll.Label"}}
    
    {{!-- Attribute --}}
    {{formInput fields.roll.fields.attribute name=(concat "system.autoSteps." idx ".roll.attribute")
      value=roll.attribute localize=true blank=false}}

    {{#if roll.attribute}}
    {{!-- Boons --}}
    {{localize "WW.Boons.With"}}
    
    {{formInput fields.roll.fields.boons name=(concat "system.autoSteps." idx ".roll.boons") value=roll.boons}}

    {{#if (lt roll.boons -1)}}{{localize "WW.Boons.Banes"}}
    {{else if (lt roll.boons 0)}}{{localize "WW.Boons.Bane"}}
    {{else if (gt roll.boons 1)}}{{localize "WW.Boons.Boons"}}
    {{else}}{{localize "WW.Boons.Boon"}}
    {{/if}}

    {{!-- Against --}}
    {{localize "WW.Roll.Against.Lc"}}
      
    {{formInput fields.roll.fields.against name=(concat "system.autoSteps." idx ".roll.against")
      value=roll.against localize=true blank=false}}
    {{/if}}
  </div>
  
  {{#if roll.attribute}}
  {{!-- Boons Alt --}}
  {{formInput fields.roll.fields.boonsAlt name=(concat "system.autoSteps." idx ".roll.boonsAlt")
    value=roll.boonsAlt dataset=(object tooltip="WW.Item.AltTip")}}
  {{/if}}
</div>