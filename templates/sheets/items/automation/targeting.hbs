<div class="targeting">
  {{!-- Heading --}}
  <h3>{{localize "WW.Targeting.Label"}}</h3>

  {{!-- Common Fields --}}
  <div class="flex-row flex-wrap gap-10 stat-inline mt-1">
    {{!-- Targeting Operation --}}
    <div class="stat-inline">
      <label>{{localize "WW.Targeting.Operations.Label"}}:</label>
      
      <select name="system.targeting.operation">
        {{selectOptions targetingOperations selected=system.targeting.operation localize=true}}
      </select>
    </div>

    {{!-- Range --}}
    {{#if (ne system.targeting.operation 'none')}}
    <div class="stat-inline">
      <label>{{localize "WW.Targeting.Range"}}:</label>

      <div class="input-wrap">
        <input type="number" name="system.targeting.range" value="{{system.targeting.range}}" min="0" data-tooltip="WW.System.YardsHint" />
        <div class="input-overlay">{{system.targeting.range}}</div>
      </div>
    </div>
    {{/if}}

    {{!-- Targeting Method --}}
    {{#if (eq system.targeting.operation 'target')}}
    <div class="stat-inline">
      <label>{{localize "WW.Targeting.Methods.Label"}}:</label>
      
      <select name="system.targeting.method">
        {{selectOptions targetingMethods selected=system.targeting.method localize=true}}
      </select>
    </div>
    
    {{!-- Targeting Restriction --}}
    {{#if (ne system.targeting.method 'self')}}
    <div class="stat-inline">
      <label>{{localize "WW.Targeting.Restrictions.Label"}}:</label>
      
      <select name="system.targeting.restriction">
        {{selectOptions targetingRestrictions selected=system.targeting.restriction localize=true}}
      </select>
    </div>
    {{/if}}
    {{/if}}

  </div>

  {{!-- Area / Region Fields --}}
  {{#if (or (eq system.targeting.operation 'placeArea') (eq system.targeting.method 'area'))}}
  <fieldset class="mt-2">
    <legend>{{localize "WW.Item.Area.Settings"}}</legend>

    <div class="flex-row flex-wrap gap-10 stat-inline">
      {{!-- Shape --}}
      <div class="stat-inline">
        <label>{{localize "WW.Item.Area.Shape.Label"}}:</label>

        {{!-- Shape icon --}}
        {{#if (eq system.area.shape "emanation")}}
        <i class="info fa-solid fa-maximize" title="{{localize "WW.Item.Area.Shape.EmanationTip"}}"></i>
        {{else}}
        <i class="info fa-solid fa-square" title="{{localize "WW.Item.Area.Shape.CircleTip"}}"></i>
        {{/if}}
        
        {{!-- Shape dropdown --}}
        <select name="system.area.shape">
          {{selectOptions areaShapes selected=system.area.shape localize=true}}
        </select>
      </div>

      {{!-- Size --}}
      {{#if (eq system.area.shape 'circle')}}
      <div class="stat-inline">
        <label>{{localize "WW.Item.Area.Size"}}:</label>

        <div class="input-wrap mr-1">
          <input type="number" name="system.area.size" value="{{system.area.size}}" min="1" data-tooltip="WW.System.YardsHint" />
          <div class="input-overlay">{{system.area.size}}</div>
        </div>
      </div>

      {{!-- Radius --}}
      {{else}}
      <div class="stat-inline">
        <label>{{localize "WW.Item.Area.Radius"}}:</label>

        <div class="input-wrap mr-1">
          <input type="number" name="system.area.radius" value="{{system.area.radius}}" min="1" data-tooltip="WW.System.YardsHint" />
          <div class="input-overlay">{{system.area.radius}}</div>
        </div>
      </div>

      {{!-- Attached --}}
      <div class="stat-inline">
        <label class="mr-0">{{localize "WW.Item.Area.AttachToToken"}}:</label>

        <input type="checkbox" name="system.area.attached" {{checked system.area.attached}} />
      </div>
      {{/if}}

      {{!-- Color --}}
      <div class="stat-inline">
        <label>{{localize "REGION.FIELDS.color.label"}}:</label>

        <color-picker name="system.area.color" value="{{system.area.color}}" placeholder="{{localize "WW.Item.Area.DefaultColor"}}">
        </color-picker>
        
        <i class="info fa-solid fa-circle-question ml-1" title="{{localize "REGION.FIELDS.color.hint"}}"></i>
      </div>
    </div>
  </fieldset>

  {{!-- Area / Region Restriction --}}
  <fieldset class="mt-2">
    <legend>{{localize "REGION.SECTIONS.restriction"}}</legend>

    <div class="stat-inline">
      {{!-- Restriction Enabled --}}
      <label>{{localize "REGION.FIELDS.restriction.enabled.label"}}:</label>

      <input type="checkbox" name="system.area.restriction.enabled" {{checked system.area.restriction.enabled}} />
      <i class="info fa-solid fa-circle-question" title="{{localize "REGION.FIELDS.restriction.enabled.hint"}}"></i>

      {{!-- Restriction Priority --}}
      <label class="ml-2">{{localize "REGION.FIELDS.restriction.priority.label"}}:</label>

      <div class="input-wrap mr-1">
        <input type="number" name="system.area.restriction.priority" value="{{system.area.restriction.priority}}" min="0"/>
        <div class="input-overlay">{{system.area.restriction.priority}}</div>
      </div>
    </div>

    {{!-- Restriction Type --}}
    <div class="stat-inline mt-1">
      <label>{{localize "REGION.FIELDS.restriction.type.label"}}:</label>

      <select name="system.area.restriction.type">
        {{selectOptions areaRestrictions selected=system.area.restriction.type localize=true}}
      </select>
    </div>
  </fieldset>
  {{/if}}
</div>