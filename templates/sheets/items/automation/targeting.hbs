<div class="targeting">
  {{!-- Common Fields --}}
  <div class="flex-row flex-wrap gap-10 stat-inline mt-1">
    {{!-- Range --}}
    <div class="stat-inline">
      <label>{{localize "WW.Targeting.Range"}}:</label>
      
      {{formInput fields.targeting.fields.range name=(concat "system.autoSteps." idx ".targeting.range")
        value=targeting.range dataset=(object tooltip="WW.System.YardsHint")}}
    </div>
  
    {{!-- Targeting Method --}}
    <div class="stat-inline">
      <label>{{localize "WW.Targeting.Methods.Label"}}:</label>
  
      {{formInput fields.targeting.fields.method name=(concat "system.autoSteps." idx ".targeting.method")
        value=targeting.method localize=true blank=false}}
    </div>
  
    {{!-- Targeting Restriction --}}
    {{#if (ne targeting.method 'self')}}
    <div class="stat-inline">
      <label>{{localize "WW.Targeting.Restrictions.Label"}}:</label>
  
      {{formInput fields.targeting.fields.restriction name=(concat "system.autoSteps." idx ".targeting.restriction" )
        value=targeting.restriction localize=true blank=false}}
    </div>
    {{/if}}
  </div>

  {{!-- Area / Region Fields --}}
  {{#if (or (eq targeting.operation 'placeArea') (eq targeting.method 'area'))}}
    <fieldset class="mt-2">
      <legend>{{localize "WW.Item.Area.Settings"}}</legend>

      <div class="flex-row flex-wrap gap-10 stat-inline">
        {{!-- Shape --}}
        <div class="stat-inline">
          <label>{{localize "WW.Item.Area.Shape.Label"}}:</label>

          {{!-- Shape icon --}}
          {{#if (eq area.shape "line")}}
            <i class="info fa-solid fa-up-long" title="{{localize "WW.Item.Area.Shape.LineTip"}}"></i>
          {{else if (eq area.shape "emanation")}}
            <i class="info fa-solid fa-maximize" title="{{localize "WW.Item.Area.Shape.EmanationTip"}}"></i>
          {{else}}
            <i class="info fa-solid fa-square" title="{{localize "WW.Item.Area.Shape.CircleTip"}}"></i>
          {{/if}}
          
          {{!-- Shape dropdown --}}
          {{formInput fields.area.fields.shape name=(concat "system.autoSteps." idx ".area.shape")
            value=area.shape localize=true blank=false}}
        </div>

        {{!-- Measure (Size, Radius, Length) --}}
        <div class="stat-inline">
          <label>
            {{#if (eq area.shape 'line')}}
              {{localize "WW.Item.Area.Length"}}:
            {{else if (eq area.shape 'emanation')}}
              {{localize "WW.Item.Area.Radius"}}:
            {{else}}
              {{localize "WW.Item.Area.Size"}}:
            {{/if}}
          </label>
          
          {{formInput fields.area.fields.measure name=(concat "system.autoSteps." idx ".area.measure")
            value=area.measure dataset=(object tooltip="WW.System.YardsHint")}}
        </div>

        {{!-- Line Width --}}
        {{#if (eq area.shape 'line')}}
        <div class="stat-inline">
          <label>{{localize "WW.Item.Area.Width"}}:</label>

          {{formInput fields.area.fields.width name=(concat "system.autoSteps." idx ".area.width")
            value=area.width dataset=(object tooltip="WW.System.YardsHint")}}
        </div>
        {{/if}}
        
        {{#if (eq area.shape 'emanation')}}
        {{!-- Token Attached --}}
        <div class="stat-inline">
          <label class="mr-0">{{localize "WW.Item.Area.AttachToToken"}}:</label>

          {{formInput fields.area.fields.attached name=(concat "system.autoSteps." idx ".area.attached")
            value=area.attached}}
        </div>
        {{/if}}

        {{!-- Color --}}
        <div class="stat-inline">
          <label>{{localize "REGION.FIELDS.color.label"}}:</label>

          <color-picker name="system.autoSteps.{{idx}}.area.color" value="{{area.color}}" placeholder="{{localize "WW.Item.Area.DefaultColor"}}">
          </color-picker>
          
          <i class="info fa-solid fa-circle-question ml-1" title="{{localize "REGION.FIELDS.color.hint"}}"></i>
        </div>
      </div>
    </fieldset>

    {{!-- Area / Region Restriction --}}
    <fieldset class="mt-2">
      <legend>{{localize "REGION.SECTIONS.restriction"}}</legend>

      <div class="stat-inline">
        {{!-- Restriction Enabled --}}
        <label>{{localize "REGION.FIELDS.restriction.enabled.label"}}:</label>

        {{formInput fields.area.fields.restriction.fields.enabled
          name=(concat "system.autoSteps." idx ".area.restriction.enabled") value=area.restriction.enabled}}

        <i class="info fa-solid fa-circle-question" title="{{localize "REGION.FIELDS.restriction.enabled.hint"}}"></i>

        {{!-- Restriction Priority --}}
        <label class="ml-2">{{localize "REGION.FIELDS.restriction.priority.label"}}:</label>
        
        {{formInput fields.area.fields.restriction.fields.priority
          name=(concat "system.autoSteps." idx ".area.restriction.priority") value=area.restriction.priority}}
      </div>

      {{!-- Restriction Type --}}
      <div class="stat-inline mt-1">
        <label>{{localize "REGION.FIELDS.restriction.type.label"}}:</label>

        {{formInput fields.area.fields.restriction.fields.type name=(concat "system.autoSteps." idx ".area.restriction.type") value=area.restriction.type localize=true}}
        </select>
      </div>
    </fieldset>
  {{/if}}
</div>