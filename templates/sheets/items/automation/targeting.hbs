<div class="targeting">
  {{!-- Common Fields --}}
  <div class="flex-row flex-wrap gap-10 stat-inline mt-1">
    {{!-- Range --}}
    <div class="stat-inline">
      <label>{{localize "WW.Targeting.Range"}}:</label>
      
      {{formInput fields.targeting.fields.range name=(concat "system.autoSteps." idx ".targeting.range")
        value=targeting.range dataset=(object tooltip="WW.System.YardsHint")}}
    </div>
  
    {{!-- Targeting Method --}}
    <div class="stat-inline">
      <label>{{localize "WW.Targeting.Methods.Label"}}:</label>
  
      {{formInput fields.targeting.fields.method name=(concat "system.autoSteps." idx ".targeting.method")
        value=targeting.method localize=true blank=false}}
    </div>
  
    {{!-- Targeting Restriction --}}
    {{#if (ne targeting.method 'self')}}
    <div class="stat-inline">
      <label>{{localize "WW.Targeting.Restrictions.Label"}}:</label>
  
      {{formInput fields.targeting.fields.restriction name=(concat "system.autoSteps." idx ".targeting.restriction" )
        value=targeting.restriction localize=true blank=false}}
    </div>
    {{/if}}
  </div>

  {{!-- Area / Region Fields --}}
  {{#if (eq targeting.method 'area')}}
    {{> "systems/weirdwizard/templates/sheets/items/automation/area.hbs"}}
  {{/if}}
</div>