<details class="automation-step">
  {{!-- Summary --}}
  <summary>
    <strong>{{localize "WW.Automation.Step.Number"}}{{number}}:</strong>
    {{summary}}
    <button class="mini float-right" data-action="stepRemove" data-step-index="{{idx}}" data-tooltip="WW.Automation.Step.Remove">
      <i class="fa-solid fa-trash"></i>
    </button>
  </summary>

  {{!-- Operation --}}
  <div class="stat-inline">
    <label>{{localize "WW.Automation.Operations.Label"}}:</label>
    {{formInput fields.operation name=(concat "system.autoSteps." idx ".operation") value=operation blank=false localize=true}}
  </div>

  {{!-- Targeting Settings --}}
  {{#if (eq operation "target")}}
    {{> "systems/weirdwizard/templates/sheets/items/automation/targeting.hbs"}}
  {{/if}}

  {{!-- Roll Settings --}}
  {{#if (eq operation "roll")}}
    {{> "systems/weirdwizard/templates/sheets/items/automation/roll.hbs"}}
  {{/if}}

  {{!-- Area Settings --}}
  {{#if (eq operation "placeArea")}}
    {{> "systems/weirdwizard/templates/sheets/items/automation/area.hbs"}}
  {{/if}}
</details>