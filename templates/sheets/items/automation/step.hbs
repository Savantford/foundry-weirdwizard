<details class="automation-step num-{{number}} {{operation}} {{#if (ne condition "none")}}condition{{/if}}">
  {{!-- Summary --}}
  <summary>
    <strong>{{localize "WW.Automation.Step.Number"}}{{number}}:</strong>
    {{summary}}
    <button class="mini float-right" data-action="stepRemove" data-step-index="{{idx}}" data-tooltip="WW.Automation.Step.Remove">
      <i class="fa-solid fa-trash"></i>
    </button>
  </summary>

  {{!-- Target --}}
  {{#if (eq operation "target")}}
    {{> "systems/weirdwizard/templates/sheets/items/automation/targeting.hbs"}}

  {{!-- Roll --}}
  {{else if (eq operation "roll")}}
    {{> "systems/weirdwizard/templates/sheets/items/automation/roll.hbs"}}

  {{!-- Request Roll --}}
  {{else if (eq operation "requestRoll")}}
    {{!--> "systems/weirdwizard/templates/sheets/items/automation/roll-request.hbs"--}}

  {{!-- Area --}}
  {{else if (eq operation "placeArea")}}
    {{> "systems/weirdwizard/templates/sheets/items/automation/area.hbs"}}

  {{!-- Affliction --}}
  {{else if (eq operation "affliction")}}
    {{> "systems/weirdwizard/templates/sheets/items/automation/affliction.hbs"}}
  
  {{!-- Active Effect --}}
  {{else if (eq operation "applyEffect")}}
    {{!--> "systems/weirdwizard/templates/sheets/items/automation/instant-effect.hbs"--}}
    
  {{!-- Instant Effect --}}
  {{else}}
    {{> "systems/weirdwizard/templates/sheets/items/automation/instant-effect.hbs"}}
  {{/if}}
</details>