<div class="affliction">
  <div class="stat-inline gap-5">
    {{!-- Affliction --}}
    <label>{{localize "WW.Affliction.Label"}}:</label>
    
    {{formInput fields.affliction.fields.key name=(concat "system.autoSteps." idx ".affliction.key")
      value=affliction.key localize=true blank=false}}

    {{!-- Trigger --}}
    <label>{{localize "WW.Effect.Trigger"}}:</label>

    {{formInput fields.instant.fields.trigger name=(concat "system.autoSteps." idx ".instant.trigger")
      value=instant.trigger localize=true blank=false}}
  
    {{!-- Restriction --}}
    <label>{{localize "WW.Targeting.Restrictions.Label"}}:</label>
    
    {{formInput fields.instant.fields.restriction name=(concat "system.autoSteps." idx ".instant.restriction")
      value=instant.restriction localize=true blank=false}}
  </div>
</div>