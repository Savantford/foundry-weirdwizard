<section class="combat-tracker plain {{#if onStandby}}standby{{/if}} {{!-- directory-list < not needed anymore? --}}">
{{#if combat}}

  {{!-- Phases --}}
  {{#each phases as |phase phaseKey|}}
  <ol class="combat-phase {{ phaseKey }}">
    {{!-- Phase Header --}}
    <li class="combat-phase-header {{#if (gte phase.actedCount phase.activeCount)}}grayed{{else if (lt phase.actedCount phase.activeCount)}}highlight{{/if}}">
  
      <div><img src="{{ phase.icon }}" /></div>
  
      <h4>{{localize phase.label}}</h4>
  
      <div class="count">{{ phase.actedCount }}/{{ phase.activeCount }}</div>
    </li>

    {{!-- Phase Turns Setup --}}
    {{#each phase.turns}}
  
    {{#if isGroup}}
      {{!-- Combatant Group --}}
      {{> "systems/weirdwizard/templates/sidebar/combat/combatant-group.hbs" this=this standby=standby}}
    {{else}}
      {{!-- Single Combatant --}}
      {{> "systems/weirdwizard/templates/sidebar/combat/combatant.hbs" this=this standby=standby}}
    {{/if}}
  
    {{/each}} {{!-- END Phase Turns Setup --}}
  </ol>
  {{/each}} {{!-- END Phases --}}
  
  {{!-- End of the Round Phase --}}
  <ol class="combat-phase end">
    <li class="combat-phase-header {{#if (gte phases.allies.actedCount phases.allies.activeCount)}}highlight{{/if}}">
      <div><img src="systems/weirdwizard/assets/icons/duration.svg" /></div>
    
      <h4>{{localize "WW.Combat.Phase.End"}}</h4>
    
      <div class="count">{{ end.length }}</div>
    </li>

    {{#each luckEnds as |luckEnd|}}
    <li class="combatant luck-ends {{ css }}" data-action="luckEndsAll" data-combatant-id="{{ combatant.id }}">
      <img class="token-image" src="{{ combatant.img }}" alt="{{ combatant.name }}" loading="lazy">

      <div class="token-name">
        <strong class="name">{{ combatant.name }}</strong>
      </div>

      {{!-- Luck Ends: Effect Buttons --}}
      <div class="luck-ends-buttons">
      {{#each effects}}
        <button class="inline-control" data-action="luckEnds" data-effect-id="{{ this.id }}" title="{{localize "WW.Effect.Duration.Expiry.LuckEnds"}}: {{ this.name }}">
          <img src={{ this.img }}>
          <img class="clover" src="systems/weirdwizard/assets/icons/clover.svg">
        </button>
      {{/each}}
      </div>
    </li>
    {{/each}}
  </ol>
  
  
{{/if}} {{!-- END If Combat --}}
</section>