
<details class="roll-details mt-1" {{#if rollDetailsOpen}}open{{/if}}>
  <summary data-action="toggleRollDetails">{{localize "WW.Roll.SeeDetails"}}</summary>
  
  <div class="wrapper">
    {{!-- Modifier --}}
    <div class="override stat-inline align-center">
    
      <label>{{localize "WW.Roll.Modifiers"}}:</label>
      
      <select name="steps.{{index}}.roll.attribute">
        {{selectOptions @root.attributeMods selected=roll.attribute localize=true}}
      </select>
    
      <span class="mx-2">{{localize "WW.Roll.Against.AndOr"}}</span>
    
      <label>{{localize "WW.Roll.Flat"}}:</label>
    
      <input name="steps.{{index}}.roll.flatMod" type="number" value="{{ roll.flatMod }}" placeholder="—" data-tooltip="WW.Roll.FlatHint" />
    </div>
    
    {{!-- Situational Boons Widget --}}
    <div class="adjustment-widget">
      <a class="down" data-action="situationalDown" data-tooltip="WW.Boons.AddBanes"></a>
    
      <input name="steps.{{index}}.rollBreakdown.boons.situational" class="boons-input situational mx-1" type="number"
        value="{{ rollBreakdown.boons.situational }}" data-tooltip="WW.Boons.Situational" />
    
      <a class="up" data-action="situationalUp" data-tooltip="WW.Boons.AddBoons"></a>
    </div>

    {{!-- List of Boons and Banes --}}
    <div class="boons-list">
      {{!-- Total Boones/Banes --}}
      <h4 class="rounded boons-header">
        <span>{{localize "WW.Boons.Total"}}</span>

        <span class="boons-display total ml-auto">{{numberFormat rollBreakdown.boons.final sign=true}}</span>
      </h4>

      {{!-- Boons Count Box --}}
      <div class="h4-box">
        {{!-- Affliction Banes --}}
        <div class="stat-stretch flex-group-left">
          <label>{{localize "WW.Boons.Afflictions"}}</label>

          <span class="boons-display">{{numberFormat rollBreakdown.boons.fromEffects sign=true}}</span>
        </div>

        {{!-- Attack Boons --}}
        {{#if forAttacks}}
        <div class="stat-stretch flex-group-left">
          <label>{{localize "WW.Boons.Attack"}}</label>
          <input type="checkbox" class="attack" name="steps.{{index}}.rollBreakdown.boons.applyAttack" data-tooltip="WW.Boons.Apply" {{#if rollBreakdown.boons.applyAttack}}checked{{/if}}>

          <span class="boons-display attack">{{numberFormat rollBreakdown.boons.forAttacks sign=true}}</span>
        </div>
        {{/if}}

        {{!-- Spell Boons --}}
        {{#if forSpells}}
        <div class="stat-stretch flex-group-left">
          <label>{{localize "WW.Boons.Spell"}}</label>
          <input type="checkbox" class="spell" name="steps.{{index}}.rollBreakdown.boons.applySpell" data-tooltip="WW.Boons.Apply" {{#if rollBreakdown.boons.applySpell}}checked{{/if}}>
          <span class="boons-display attack">{{numberFormat rollBreakdown.boons.forSpells sign=true}}</span>
        </div>
        {{/if}}

        {{!-- Fixed Boons --}}
        {{#if fixed}}
        <div class="stat-stretch flex-group-left">
          <label>{{localize "WW.Boons.Fixed"}}</label>
          <span class="boons-display fixed">{{numberFormat rollBreakdown.boons.fixed sign=true}}</span>
        </div>
        {{/if}}
      </div>
    </div>
    
    {{!-- Against --}}
    <div class="override stat-inline align-center">
      <label>{{localize "WW.Roll.Against.Label"}}:</label>
    
      <select name="steps.{{index}}.roll.against">
        {{selectOptions @root.againstKeys selected=roll.against localize=true}}
      </select>
    
      <span class="mx-2">{{localize "WW.Roll.Against.Or"}}</span>
    
      <label>{{localize "WW.Roll.Against.CustomTargetNumber"}}:</label>
    
      <input name="steps.{{index}}.rollBreakdown.against.customTn" type="number" value="{{ rollBreakdown.against.customTn }}" placeholder="—"
        data-tooltip="WW.Roll.Against.CustomTargetNumberHint" />
    </div>
  </div>

</details>