<div class="instant-effect">
  <div class="stat-row">
    {{!-- Value --}}
    <span class="stat-inline">
      <label>{{localize "WW.InstantEffect.Value"}}:</label>

      {{formInput @root.instantFields.value name=(concat "steps." index ".instant.value") value=instant.value}}
    </span>
    
    {{!-- Condition --}}
    <span class="stat-inline">
      <label>{{localize "WW.Automation.Condition.Label"}}:</label>

      {{formInput @root.fields.condition name=(concat "steps." index ".condition") value=condition localize=true blank=false}}
    </span>

    {{!-- Restriction --}}
    <span class="stat-inline">
      <label>{{localize "WW.Targeting.Restrictions.Label"}}:</label>

      {{formInput @root.instantFields.restriction name=(concat "steps." index ".instant.restriction")
        value=instant.restriction localize=true blank=false}}
    </span>
  </div>
</div>