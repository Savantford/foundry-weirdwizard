<section class="roll">
  {{!-- Roll Expression --}}
  {{#with roll}}
  <div class="roll-expression">{{ expression }}</div>
  
  {{!-- Icons --}}
  <div class="icons-expression mt-1">
    {{!-- d20 --}}
    <div class="term d20">
      <img src="icons/svg/d20-highlight.svg"></img>
      <div>d20</div>
    </div>

    {{!-- Attribute Modifier --}}
    {{#if attribute}}
    <div class="operator attribute">{{#if (lt attributeBreakdown.mod 0)}}−{{else}}+{{/if}}</div>

    <div class="term attribute" data-tooltip="{{ attributeBreakdown.label }}">
      <div>{{ attributeBreakdown.mod }}</div>
      <img src="{{ attributeBreakdown.icon }}" />
    </div>
    {{/if}}

    {{!-- Flat Modifier --}}
    {{#if flatMod}}
    <div class="operator flat" data-tooltip="WW.Roll.Flat">{{#if (lt flatMod 0)}}−{{else}}+{{/if}} {{ flatModAbs }}</div>
    {{/if}}
  
    {{!-- Boons --}}
    {{#if (gt boonsBreakdown.final 0)}}
    <div class="operator boons">+</div>

    <div class="term boons" data-tooltip="{{ boonsBreakdown.abs }} {{localize "WW.Roll.Boons"}}">
      <div>{{ boonsBreakdown.display }}d6kh</div>
      <img src="systems/weirdwizard/assets/icons/rolling-boon{{#if (gt boonsBreakdown.abs 1)}}s{{/if}}-colored.svg"/>
    </div>

    {{!-- Banes --}}
    {{else if (lt boonsBreakdown.final 0)}}
    <div class="operator banes">−</div>

    <div class="term banes" data-tooltip="{{ boonsBreakdown.abs }} {{localize "WW.Roll.Banes"}}">
      <div>{{ boonsBreakdown.display }}d6kh</div>
      <img src="systems/weirdwizard/assets/icons/rolling-bane{{#if (gt boonsBreakdown.abs 1)}}s{{/if}}-colored.svg"/>
    </div>
    {{/if}}

    {{!-- Against --}}
    {{#if (or against (ne againstBreakdown.tn 10))}}
    <div class="operator against mx-1">vs</div>

    <div class="term against" data-tooltip="{{ againstBreakdown.label }}">
      {{#unless against}}<div>{{ againstBreakdown.tn }}</div>{{/unless}}

      <img src="{{ againstBreakdown.icon }}" />
    </div>
    {{/if}}
  </div>
  {{/with}}

  {{!-- Roll Details Collapsible --}}
  {{> "systems/weirdwizard/templates/apps/activity/steps/parts/roll-details.hbs"}}
</section>