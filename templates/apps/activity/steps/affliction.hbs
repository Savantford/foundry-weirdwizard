<div class="affliction">
  <div class="stat-row">
    {{!-- Affliction --}}
    <span class="stat-inline">
      <label>{{localize "WW.Affliction.Label"}}:</label>

      {{formInput @root.afflictionFields.key name=(concat "steps." index ".affliction.key") value=affliction.key localize=true blank=false}}
    </span>
    
    {{!-- Condition --}}
    <span class="stat-inline">
      <label>{{localize "WW.Automation.Condition.Label"}}:</label>

      {{formInput @root.fields.condition name=(concat "steps." index ".condition") value=condition localize=true blank=false}}
    </span>

    {{!-- Restriction --}}
    <span class="stat-inline">
      <label>{{localize "WW.Targeting.Restrictions.Label"}}:</label>

      {{formInput @root.afflictionFields.restriction name=(concat "steps." index ".affliction.restriction")
        value=affliction.restriction localize=true blank=false}}
    </span>
  </div>
</div>