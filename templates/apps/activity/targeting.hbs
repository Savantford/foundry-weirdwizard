<section class="targeting">
  {{#unless noTargeting}}
  <h2>{{localize "WW.Targeting.Targets"}}</h2>

  {{!-- Add Buttons --}}
  <button data-action="targetingSelectTargets">
    <i class="fa-solid fa-arrows-down-to-people"></i> {{localize "WW.Targeting.Manual"}}
  </button>
  
  <button data-action="targetingTemplate">
    <i class="fa-solid fa-users-viewfinder"></i> {{localize "WW.Targeting.AreaTarget"}}
  </button>

  {{!-- Targets Box --}}
  <div class="targets-box" data-tooltip="WW.Activity.Target.TargetingInfo">
    {{#each targets as |target id|}}
    <li>
      <label><img class="target-icon" src="{{ img }}"> {{ name }}</label>
  
      {{#if autoSuccess}}
      <div class="target-auto-success" data-tooltip="{{localize 'WW.Roll.AutoSuccess'}}">
        <i class="fa-solid fa-check color-green"></i> {{localize "WW.Roll.AutoSuccess"}}
      </div>
  
      {{else if againstNo}}
      {{#if (ne boonsNo 0)}}
      <div class="target-boons">({{ boonsNo }} <img src="{{ boonsIcon }}" data-tooltip="{{boonsTip}}" />)</div>
      {{/if}}
  
      <div class="target-against" data-tooltip="{{ againstLabel }}">{{ againstNo }} <img src="{{ againstIcon }}"></div>
      {{/if}}
    </li>
    {{else}}
      {{localize "WW.Activity.Target.None"}}
    {{/each}}
  </div>

  {{!-- Restrict By --}}
  <div class="buttons">
    <button data-action="targetingRestrictBy" data-selected="any" data-tooltip="WW.Effect.AnyTargeted">
      {{localize "WW.Effect.Any"}}
    </button>

    <button data-action="targetingRestrictBy" data-selected="enemies" data-tooltip="WW.Effect.EnemiesTargeted">
      {{localize "WW.Effect.Enemies"}}
    </button>

    <button data-action="targetingRestrictBy" data-selected="allies" data-tooltip="WW.Effect.AlliesTargeted">
      {{localize "WW.Effect.Allies"}}
    </button>
  </div>
  {{/unless}}
</section>