<section class="targeting">
  {{!-- Heading --}}
  <h4 class="icon"><i class="fa-regular fa-bullseye"></i> {{localize "WW.Targeting.Targets"}}</h4>

  {{!-- Targeting Buttons --}}
  <div class="buttons">
    {{!-- Toggle Targeting Helper --}}
    <button data-action="selectTargets">
      <i class="fa-solid fa-arrows-down-to-people"></i> {{localize "WW.Targeting.Manual"}}
    </button>
    
    {{!-- Place templates --}}
    {{#if (eq targeting.operation 'areaTarget')}}
    <button data-action="placeArea">
      <i class="fa-solid fa-users-viewfinder"></i> {{localize "WW.Activity.Target.AreaTarget"}}
    </button>
    {{else if (eq targeting.operation 'areaPersistent')}}
    <button data-action="placeArea">
      <i class="fa-regular fa-square-full"></i> {{localize "WW.Activity.Target.PlaceTemplate"}}
    </button>
    {{/if}}
  </div>

  {{!-- Targeting Restriction --}}
  <div class="split-button targeting-restriction mt-1">
    {{#each targetingRestrictions as |restriction|}}
    <button type="button" class="ui-control" data-action="targetingRestriction"
      data-restriction="{{restriction.action}}" aria-pressed="{{restriction.active}}">
      {{localize restriction.label}}
    </button>
    {{/each}}
  </div>

  {{!-- Targets Box --}}
  <div class="targets-box mt-1 mb-1" data-tooltip="WW.Activity.Target.TargetingInfo">
    {{!-- Valid Targets --}}
    {{#each validTargets as |target id|}}
    <li>
      <label><img class="target-icon" src="{{ img }}"> {{ name }}</label>
  
      {{#if autoSuccess}}
      <div class="target-auto-success" data-tooltip="{{localize 'WW.Roll.AutoSuccess'}}">
        <i class="fa-solid fa-check color-green"></i> {{localize "WW.Roll.AutoSuccess"}}
      </div>
  
      {{else if againstNo}}
      {{#if (ne boonsNo 0)}}
      <div class="target-boons">({{ boonsNo }} <img src="{{ boonsIcon }}" data-tooltip="{{ boonsTip }}" />)</div>
      {{/if}}

      {{!-- Against --}}
      <div class="target-against" data-tooltip="{{ @root.roll.against.label }}">
        <span>{{ againstNo }}</span>
        <img src="{{ @root.roll.against.icon }}">
      </div>
      {{/if}}
    </li>
    {{else}}
      {{localize "WW.Activity.Target.None"}}
    {{/each}}

    {{!-- Invalid Targets --}}
    {{#each invalidTargets as |target id|}}
    <li class="invalid">
      <label><img class="target-icon" src="{{ img }}"> {{ name }}</label>
    </li>
    {{/each}}
  </div>

</section>