<section class="targeting">
  {{#unless noTargeting}}
  <h2>{{localize "WW.Targeting.Targets"}}</h2>

  {{!-- Targeting Buttons --}}
  <div class="buttons">
    {{!-- Toggle Targeting HUD --}}
    <button data-action="selectTargets">
      <i class="fa-solid fa-arrows-down-to-people"></i> {{localize "WW.Targeting.Modes.Manual"}}
    </button>
    
    {{!-- Place templates --}}
    {{#if (eq targeting.mode 'areaTarget')}}
    <button data-action="placeTemplate">
      <i class="fa-solid fa-users-viewfinder"></i> {{localize "WW.Activity.Target.AreaTarget"}}
    </button>
    {{else if (eq targeting.mode 'areaPersistent')}}
    <button data-action="placeTemplate">
      <i class="fa-regular fa-square-full"></i> {{localize "WW.Activity.Target.PlaceTemplate"}}
    </button>
    {{/if}}
  </div>

  {{!-- Targets Box --}}
  <div class="targets-box" data-tooltip="WW.Activity.Target.TargetingInfo">
    {{#each targets as |target id|}}
    <li>
      <label><img class="target-icon" src="{{ img }}"> {{ name }}</label>
  
      {{#if autoSuccess}}
      <div class="target-auto-success" data-tooltip="{{localize 'WW.Roll.AutoSuccess'}}">
        <i class="fa-solid fa-check color-green"></i> {{localize "WW.Roll.AutoSuccess"}}
      </div>
  
      {{else if againstNo}}
      {{#if (ne boonsNo 0)}}
      <div class="target-boons">({{ boonsNo }} <img src="{{ boonsIcon }}" data-tooltip="{{boonsTip}}" />)</div>
      {{/if}}
  
      <div class="target-against" data-tooltip="{{ againstLabel }}">{{ againstNo }} <img src="{{ againstIcon }}"></div>
      {{/if}}
    </li>
    {{else}}
      {{localize "WW.Activity.Target.None"}}
    {{/each}}
  </div>

  {{!-- Targeting Mode --}}
  <div class="split-button targeting-mode">
    {{#each targetingModes as |mode|}}
    <button type="button" class="ui-control" data-action="targetingMode" data-mode="{{mode.action}}" aria-pressed="{{mode.active}}">
      {{localize mode.label}}
    </button>
    {{/each}}
  </div>
  {{/unless}}

  {{!-- Message Mode --}}
  <div id="message-modes" class="split-button">
    {{#each messageModes as |mode|}}
    <button type="button" class="ui-control icon {{mode.icon}}" data-action="messageMode" data-mode="{{mode.action}}"
      aria-pressed="{{mode.active}}" data-tooltip aria-label="{{localize mode.label}}"></button>
    {{/each}}
  </div>

</section>