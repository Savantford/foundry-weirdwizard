<ol class="area-info">
  {{!-- Range --}}
  <li>{{localize "WW.Targeting.Range"}} {{ targeting.range }}</li>

  {{!-- Emanation Radius --}}
  {{#if (eq area.shape "emanation")}}
    <li>{{localize "WW.Item.Area.Shape.Emanation"}}</li>
    <li>{{localize "WW.Item.Area.Radius"}} {{ area.measure }}</li>
  
  {{!-- Line Length and Width --}}
  {{else if (eq area.shape "line")}}
    <li>{{localize "WW.Item.Area.Shape.Line"}}</li>
    <li>{{localize "WW.Item.Area.Length"}} {{ area.measure }}</li>
    <li>{{localize "WW.Item.Area.Width"}} {{ area.width }}</li>

  {{!-- Circle Size --}}
  {{else}}
    <li>{{localize "WW.Item.Area.Shape.Circle"}}</li>
    <li>{{localize "WW.Item.Area.Size"}} {{ area.measure }}</li>
  {{/if}}
</ol>