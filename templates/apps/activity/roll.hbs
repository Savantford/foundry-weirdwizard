<section class="roll">
  {{!-- Heading --}}
  <h4 class="icon"><i class="fa-regular fa-dice-d20"></i> {{localize "WW.Roll.Label"}}</h4>
  {{log roll}}
  {{!-- Roll Expression --}}
  {{#with roll}}
  <div class="roll-expression">{{ expression }}</div>
  
  {{!-- Icons --}}
  <div class="icons-expression mt-1">
    
    {{!-- d20 --}}
    <div class="term d20">
      <img src="icons/svg/d20-highlight.svg"></img>
      <div>d20</div>
    </div>

    {{!-- Attribute Modifier --}}
    {{#if attribute.key}}
    <div class="operator attribute">{{#if (lt attribute.mod 0)}}−{{else}}+{{/if}}</div>

    <div class="term attribute" data-tooltip="{{ attribute.label }}">
      <div>{{ attribute.mod }}</div>
      <img src="{{ attribute.icon }}" />
    </div>
    {{/if}}

    {{!-- Flat Modifier --}}
    {{#if flatMod}}
    <div class="operator flat" data-tooltip="WW.Roll.Flat">{{#if (lt flatMod 0)}}−{{else}}+{{/if}} {{ flatModAbs }}</div>
    {{/if}}
  
    {{!-- Boons --}}
    {{#if (gt boons.final 0)}}
    <div class="operator boons">+</div>

    <div class="term boons" data-tooltip="{{ boons.abs }} {{localize "WW.Roll.Boons"}}">
      <div>{{ boons.display }}d6kh</div>
      <img src="systems/weirdwizard/assets/icons/rolling-boons-colored.svg"></img>
    </div>

    {{!-- Banes --}}
    {{else if (lt boons.final 0)}}
    <div class="operator banes">−</div>

    <div class="term banes" data-tooltip="{{ boons.abs }} {{localize "WW.Roll.Banes"}}">
      <div>{{ boons.display }}d6kh</div>
      <img src="systems/weirdwizard/assets/icons/rolling-banes-colored.svg"></img>
    </div>
    {{/if}}
  </div>
  {{/with}}

  {{!-- Roll Customization --}}
  <details class="roll-details mt-1" {{#if args.rollDetailsOpen}}open{{/if}}>
    <summary data-action="toggleRollDetails">{{localize "WW.Roll.SeeDetails"}}</summary>

    <div class="roll-main">
      {{!-- Total Boones/Banes --}}
      <h4 class="rounded boons-header">
        <span>{{localize "WW.Boons.Total"}}</span>

        <span class="boons-display total ml-auto">{{ boonsFinal }}</span>
      </h4>

      {{!-- Boons Count Box --}}
      <div class="h4-box">
        {{#with roll.boons}}
        {{!-- Affliction Banes --}}
        <div class="stat-stretch flex-group-left">
          <label>{{localize "WW.Boons.Afflictions"}}</label>
          <span class="boons-display">{{numberFormat fromEffects decimals=0 sign=true}}</span>
        </div>

        {{!-- Attack Boons --}}
        {{#if forAttacks}}
        <div class="stat-stretch flex-group-left">
          <label>{{localize "WW.Boons.Attack"}}</label>
          <input name="applyAttackBoons" class="damage-checkbox attack" type="checkbox" data-tooltip="WW.Boons.Apply"
            {{#if inputs.applyAttackBoons}}checked{{/if}}>
          <span class="boons-display attack">{{numberFormat forAttacks decimals=0 sign=true}}</span>
        </div>
        {{/if}}

        {{!-- Fixed Boons --}}
        {{#if fixed}}
        <div class="stat-stretch flex-group-left">
          <label>{{localize "WW.Boons.Fixed"}}</label>
          <span class="boons-display fixed">{{numberFormat fixed decimals=0 sign=true}}</span>
        </div>
        {{/if}}
        {{/with}}
      </div>

    </div>

    {{!-- Right Column --}}
    <div class="roll-options">
      {{!-- Situational Boons Widget --}}
      <div class="adjustment-widget">
        <a class="down" data-action="situationalDown" data-tooltip="WW.Boons.AddBanes"></a>
      
        <input name="situationalBoons" class="boons-input situational mx-1" type="number"
          value="{{ inputs.situationalBoons }}" data-tooltip="WW.Boons.Situational" />
      
        <a class="up" data-action="situationalUp" data-tooltip="WW.Boons.AddBoons"></a>
      </div>

      {{!-- Custom Target Number --}}
      <div class="override stat-inline align-center">
        <label>{{localize "WW.Roll.Flat"}}:</label>
        <input name="flatMod" type="number" value="{{ inputs.flatMod }}" placeholder="—"
          data-tooltip="WW.Roll.FlatHint" />
      </div>

      {{!-- Custom Target Number --}}
      <div class="override stat-inline align-center">
        <label>{{localize "WW.Roll.TargetNumber"}}:</label>
        <input name="customTn" type="number" value="{{ inputs.customTn }}" placeholder="—"
          data-tooltip="WW.Roll.TargetNumberHint" />
      </div>

    </div>
  </details>

</section>