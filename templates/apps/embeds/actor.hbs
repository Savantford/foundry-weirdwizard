<section class="document-card">
    {{#if text}}
    {{!-- Heading & Description --}}
    <div class="card-text">
        <h6>{{label}}</h6>

        {{{text}}}
    </div>
    {{/if}}

    <section class="statbox">
        <div class="statbox-header">
            {{!-- Name --}}
            <h4>{{{ docLink }}}</h4>

            {{!-- Descriptors --}}
            <h5>
                {{#if listEntries.descriptors.length}}
                    <ol class="list-entries">
                        {{#each listEntries.descriptors as |entry|}}
                            {{> listEntry entry=entry listKey="descriptors" loc="Descriptor" isEditMode=false }}
                        {{/each}}
                    </ol>
                {{/if}}

                {{!-- Individual Traits --}}
                {{#if actor.system.details.individualTraits}}
                    {{#if listEntries.descriptors.length}}<span>•</span>{{/if}}
                    <span class="individual-traits">{{ actor.system.details.individualTraits }}</span>
                {{/if}}

                <span>•</span>
                
                {{!-- Difficulty --}}
                {{localize "WW.Stats.Difficulty"}} {{ system.stats.difficulty }}
            </h5>

            {{!-- Image --}}
            <img class="statbox-image" src="{{ img }}">
        </div>

        {{!-- Basic Stats --}}
        <p>
            <strong>{{localize "WW.Defense.Label"}}:</strong>
            {{ system.stats.defense.total }}{{#if items.equipment.length}} (<span class="equipment-list">{{#each items.equipment as |item id|}}<span class="item">{{ name }}</span>{{/each}}</span>){{/if}},
            <strong>{{localize "WW.Health.Label"}}:</strong>
            {{ system.stats.health.normal }}
        </p>

        <p>
            <strong>{{localize "WW.Attributes.Strength"}}:</strong> {{ system.attributes.str.value }} ({{numberFormat system.attributes.str.mod sign=true }}),
            <strong>{{localize "WW.Attributes.Agility"}}:</strong> {{ system.attributes.agi.value }} ({{numberFormat system.attributes.agi.mod sign=true }})
        </p>

        <p>
            <strong>{{localize "WW.Attributes.Intellect"}}:</strong> {{ system.attributes.int.value }} ({{numberFormat system.attributes.int.mod sign=true }}),
            <strong>{{localize "WW.Attributes.Will"}}:</strong> {{ system.attributes.wil.value }} ({{numberFormat system.attributes.wil.mod sign=true }})
        </p>

        <div>
            <strong>{{localize "WW.Stats.Size"}}:</strong> {{ system.stats.sizeFraction }},
            <strong>{{localize "WW.Stats.Speed"}}:</strong> {{ system.stats.speed.normal }} {{#if listEntries.movementTraits.length}}(<ol class="stat-inline list-entries">
                {{#each listEntries.movementTraits as |entry|}}
                    {{> listEntry entry=entry listKey="movementTraits" loc="movementTraits" isEditMode=false }}
                {{/each}}
            </ol>){{/if}}
        </div>

        {{!-- Languages --}}
        {{#if listEntries.languages.length}}
        <ol class="stat-inline list-entries">
            <strong>{{localize "WW.ListEntry.Language.Label"}}:</strong>

            {{#each listEntries.languages as |entry|}}
                {{> listEntry entry=entry listKey="languages" loc="Language" isEditMode=false }}
            {{/each}}
        </ol>
        {{/if}}
        
        {{!-- Senses --}}
        {{#if listEntries.senses.length}}
        <ol class="stat-inline list-entries">
            <strong>{{localize "WW.ListEntry.Sense.Label"}}:</strong>
        
            {{#each listEntries.senses as |entry|}}
                {{> listEntry entry=entry listKey="senses" loc="Sense" isEditMode=false }}
            {{/each}}
        </ol>
        {{/if}}
        
        {{!-- Immune --}}
        {{#if listEntries.immunities.length}}
        <ol class="stat-inline list-entries">
            <strong>{{localize "WW.ListEntry.Immunity.Label"}}:</strong>
        
            {{#each listEntries.immunities as |entry|}}
                {{> listEntry entry=entry listKey="immunities" loc="Immunity" isEditMode=false }}
            {{/each}}
        </ol>
        {{/if}}

        {{!-- Traits & Talents --}}
        {{#if items.talent.length}}
        <ol class="described-list">
            {{#each items.talent as |item id|}}
                <li class="item"><strong>{{ label }}:</strong> {{{ desc }}}</li>
            {{/each}}
        </ol>
        {{/if}}
        
        {{!-- Actions Section --}}
        {{#if (or items.weapon.length items.action.length items.spell.length)}}
        <div class="statbox-section actions">
        
            {{!-- Actions Header --}}
            <h6>{{localize "WW.Talents.Actions"}}</h6>
        
            {{!-- Attacks --}}
            {{#if items.weapon.length}}
            <ol class="described-list attacks-list">
                {{#each items.weapon as |item id|}}
                    <li class="item">
                        {{!-- Title --}}
                        <strong>{{ label }}:</strong>
                        
                        {{!-- Modifier --}}
                        <span class="modifier-line">
                            {{localize system.attributeLabel}}

                            {{!-- Boons --}}
                            {{#if system.boonsLabel}}{{ system.boonsLabel }}{{else}}{{ system.boons }}{{/if}}
                        </span>
                        
                        {{!-- Damage --}}
                        <span class="damage-line">({{#if system.damageAlt}}{{ system.damageAlt }}{{else if system.damage}}{{ system.damage }}{{else}}0{{/if}})</span>
                        
                        {{#if attackRider.name}}
                        <div class="attack-rider">
                            <strong>{{ attackRider.name }}:</strong> {{{ attackRider.value }}}
                        </div>
                        {{/if}}
                    </li>
                    {{{ description }}}
                {{/each}}
            </ol>
            {{/if}}
        
            {{!-- Special Actions --}}
            {{#if items.action.length}}
            <ol class="described-list actions-list">
                {{#each items.action as |item id|}}
                    <li class="item"><strong>{{ label }}:</strong> {{{ desc }}}</li>
                {{/each}}
            </ol>
            {{/if}}
        
            {{!-- Spells --}}
            {{#if items.spell.length}}
            <ol class="described-list spells-list">
                {{#each items.spell as |item id|}}
                    <li class="item"><strong>{{ label }}:</strong> {{{ desc }}}</li>
                {{/each}}
            </ol>
            {{/if}}
        
        </div>
        {{/if}}
        
        {{!-- Reactions Section --}}
        {{#if items.reaction.length}}
        <div class="statbox-section reactions">
        
            <h6>{{localize "WW.Talents.Reactions"}}</h6>
        
            <ol class="described-list">
                {{#each items.reaction as |item id|}}
                    <li class="item"><strong>{{ label }}:</strong> {{{ desc }}}</li>
                {{/each}}
            </ol>
        
        </div>
        {{/if}}
        
        {{!-- End of Round Section --}}
        {{#if items.end.length}}
        <div class="statbox-section ends">
            <h6>{{localize "WW.Talents.Ends"}}</h6>
        
            <ol class="described-list">
                {{#each items.end as |item id|}}
                    <li class="item"><strong>{{ label }}:</strong> {{{ desc }}}</li>
                {{/each}}
            </ol>
        
        </div>
        {{/if}}

    </section>

</section>