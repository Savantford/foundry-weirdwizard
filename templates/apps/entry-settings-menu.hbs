<div>
    {{!-- Afflictions Drag and Drop Tip --}}
    {{#if (eq listKey "afflictions")}}<p>{{localize "WW.Settings.Afflictions.DropHint"}}</p>{{/if}}
    
    {{!-- List --}}
    <ol class="permissions-list">
        <header class="table-header flexrow">
            <label class="index">{{listTitle}}</label>
            
            <div class="control">
                <a data-action="addSet"><i class="fa-solid fa-plus-circle"></i> {{localize "WW.Settings.Entry.AddSet"}}</a>

                <a data-action="addEntry"><i class="fa-solid fa-plus-circle"></i> {{localize "WW.Settings.Entry.Add"}}</a>
            </div>
            
        </header>
    {{#each list as |entry key|}}
        <li class="draggable form-group" data-entry-data="{{entry}}">
            <label>{{localize entry.name}} {{#if entry.img}}<img class="mini-icon" src="{{ entry.img }}">{{/if}}</label>

            <div class="control form-fields">
                <a data-action="editEntry" data-entry-key="{{key}}" data-tooltip="WW.Settings.Entry.Edit"><i class="fa-solid fa-edit"></i></a>

                <a data-action="removeEntry" data-entry-key="{{key}}" data-tooltip="WW.Settings.Entry.Remove"><i class="fa-solid fa-trash"></i></a>
            </div>

            <div class="hint">{{{ entry.desc }}}</div>
        </li>
    {{/each}}
    </ol>
</div>
